# Copy this file to .dev.vars and replace every placeholder locally.
# Never commit .dev.vars or real credentials.
BASIC_AUTH="replace-with-local-user:replace-with-local-password"
APNS_PRIVATE_KEY="replace-with-local-pkcs8-private-key"
APNS_TEAM_ID="replace-with-local-team-id"
APNS_KEY_ID="replace-with-local-key-id"
APNS_TOPIC="replace-with-local-app-topic"

# Non-browser MCP clients may omit Origin. If Origin is sent, configure a
# comma-separated list of exact scheme://host[:port] values; wildcards are rejected.
MCP_ALLOWED_ORIGINS=""

# Required only when ALLOW_LEGACY_GET_REGISTER="true". Uncomment this setting and
# use the real migration deadline in valid HTTP-date form; do not invent a date.
# LEGACY_GET_REGISTER_SUNSET="<valid HTTP-date selected for this migration>"
