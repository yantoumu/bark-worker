{
    "name": "bark-worker",
    "description": "Bark Server on Cloudflare Worker",
    "type": "module",
    "cloudflare": {
        "label": "Bark Server",
        "products": [
            "Workers",
            "D1"
        ],
        "categories": [],
        "icon_urls": [],
        "docs_url": "https://developers.cloudflare.com/workers/",
        "preview_image_url": "https://github.com/cwxiaos/bark-worker/blob/master/doc/images/bark.jpeg",
        "dash": true
    },
    "devDependencies": {
        "wrangler": "4.123.0"
    },
    "scripts": {
        "test": "node --test test/*.test.js",
        "test:compat": "node --test test/push-compatibility.test.js",
        "test:coverage": "npm run test:coverage:d1 && npm run test:coverage:kv",
        "test:coverage:d1": "node --test --experimental-test-coverage --test-coverage-include=main.js --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=85 test/*.test.js",
        "test:coverage:kv": "node --test --experimental-test-coverage --test-coverage-include=main_kv.js --test-coverage-lines=80 --test-coverage-branches=75 --test-coverage-functions=85 test/*.test.js",
        "check:syntax": "node scripts/verify-syntax.mjs",
        "cf-typegen": "wrangler types",
        "db:migrate": "wrangler d1 migrations apply database --local",
        "db:migrate:remote": "wrangler d1 migrations apply database --remote",
        "deploy": "wrangler deploy",
        "deploy:dry-run": "node scripts/verify-dry-run.mjs",
        "dev": "wrangler dev",
        "preview": "wrangler dev",
        "verify": "npm run check:syntax && npm run test:coverage && npm run deploy:dry-run"
    }
}
